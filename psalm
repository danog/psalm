#!/usr/bin/env php
<?php

namespace Psalm;

use Psalm\Internal\Cli\Psalm;

// Psalm's own Composer autoloader: in a checkout, or the project's when installed as a dependency
foreach ([__DIR__ . '/vendor/autoload.php', \dirname(__DIR__, 2) . '/autoload.php'] as $autoload_file) {
    if (\file_exists($autoload_file)) {
        require_once $autoload_file;
        break;
    }
}
Psalm::run($argv);

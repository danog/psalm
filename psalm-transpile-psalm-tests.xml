<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    name="Transpile Psalm with tests"
    errorLevel="8"
    throwExceptionOnError="0"
    findUnusedCode="false"
    xsi:schemaLocation="https://getpsalm.org/schema/config config.xsd"
    allFunctionsGlobal="true"
    allConstantsGlobal="true"
    usePhpDocMethodsWithoutMagicCall="true"
    cacheDirectory="build/psalm-cache-psalm-tests"
>
    <stubs>
        <file name="stubs/phpparser.phpstub"/>
    </stubs>
    <projectFiles>
        <directory name="../psalm-transpiler/src/Psalm/Internal/Transpiler/runtime-stubs"/>
        <directory name="../php-parser/lib"/>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="tests/fixtures"/>
            <directory name="tests/EndToEnd"/>
            <directory name="tests/LanguageServer"/>
            <file name="tests/autoload.php"/>
            <file name="tests/ErrorBaselineTest.php"/>
            <file name="tests/PsalmPluginTest.php"/>
            <file name="tests/Config/PluginListTest.php"/>
            <directory name="src/Psalm/Internal/LanguageServer"/>
            <directory name="src/Psalm/Internal/Fork"/>
            <directory name="src/Psalm/Internal/PluginManager/Command"/>
            <file name="src/Psalm/Internal/Cli/LanguageServer.php"/>
            <directory name="vendor/amphp"/>
            <directory name="vendor/symfony"/>
            <directory name="vendor/composer"/>
            <directory name="vendor/nikic"/>
            <directory name="vendor/phpunit"/>
        </ignoreFiles>
    </projectFiles>
</psalm>

<?php

/**
 * Psalm-visible declarations of the transpiler's runtime hook functions (implemented natively in php-rt and
 * mapped by Builtins.php, so they have no PHP body): analysis sees their precise types instead of `mixed`.
 */

/** @return list<array{int, string, int, int}> */
function __rt_tokenize(string $code): array {}

/** @return list<array{string, string, bool, array<string, string>, int, int}>|null name, text, is text node, attributes, parent index (-1: root), source line */
function __rt_xml_parse(string $xml): ?array {}

function __rt_xml_escape(string $text, bool $attribute = false): string {}

function __rt_class_file(string $class): ?string {}

function __rt_function_is_builtin(string $name): bool {}

function __rt_class_is_trait(string $class): bool {}

/** Encode a value for a worker's result pipe; every PHP value type but closures, resources and iterators can be. */
function __rt_encode(mixed $value): string {}
/** The value a worker sent, decoded as the enclosing function's declared return type: only valid as `return __rt_decode($bytes);`. */
function __rt_decode(string $bytes): mixed {}
/** Fork `n` workers: each child returns its index (0..n), the parent returns -1 once all run. */
function __rt_fork_workers(int $n): int {}
/** A worker's last act: send its encoded result to the parent and exit. */
function __rt_worker_exit(string $payload): never {}
/** The parent: every worker's result in worker order; a failed worker throws. @return list<string> */
function __rt_collect_workers(): array {}
function __rt_cpu_count(): int {}

/** A plugin class compiled into the program, built from its name; null for a name the program does not know (a table the crate emitter generates). */
function __rt_instantiate_plugin(string $class): \Psalm\Plugin\PluginInterface|\Psalm\Plugin\HookInterface|null {}


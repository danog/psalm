<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    name="Transpile php-parser"
    errorLevel="8"
    throwExceptionOnError="0"
    findUnusedCode="false"
    xsi:schemaLocation="https://getpsalm.org/schema/config config.xsd"
    allFunctionsGlobal="true"
    allConstantsGlobal="true"
    usePhpDocMethodsWithoutMagicCall="true"
    cacheDirectory="build/psalm-cache-phpparser"
>
    <projectFiles>
        <directory name="src/Psalm/Internal/Transpiler/runtime-stubs"/>
        <directory name="build/php-parser/lib"/>
        <directory name="build/php-parser/test/PhpParser"/>
        <file name="build/php-parser/test/bootstrap.php"/>
        <file name="build/php-parser/test/fixtures/Suit.php"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
</psalm>
